{
  "name": "que0p",
  "version": "1.0.0",
  "description": "Twitch queue bot with automated ready-up, AFK checks and OBS overlay",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx src/setup-tokens.ts",
    "test": "vitest run",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production')require('child_process').execSync('husky',{stdio:'inherit'})\"",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/easy-bot": "^8.2.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
